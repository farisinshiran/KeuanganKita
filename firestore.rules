rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User data: Only authenticated users can access their own data
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User settings (including Vision API key): Only authenticated users can access their own settings
    match /artifacts/{appId}/users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}