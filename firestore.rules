rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Household data: Any authenticated user can read households list,
    // but only household members (via anonymous auth) can write their own household.
    // PIN/passHash provides the real access control at the app layer.
    match /households/{householdId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.authUid;
      allow create: if request.auth != null;
    }

    // Household user data: Same as users/{userId}, but under household namespace
    match /artifacts/{appId}/households/{householdId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Google user data: Only authenticated users can access their own data
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User settings (including Vision API key): Only authenticated users can access their own settings
    match /artifacts/{appId}/users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}