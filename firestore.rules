rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All app data lives under artifacts/{appId}/users/{uid}/
    // UID comes from anonymous Firebase Auth (used by both Google login and PIN login).
    // - Google login: uid = Firebase Auth user.uid
    // - PIN login:    uid = hash(name + role + familyId) stored in familyAuth.js
    //
    // Each family shares the same familyId but has unique uids per member.
    match /artifacts/{appId}/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User settings (including Vision API key)
    match /artifacts/{appId}/users/{uid}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Kids feature: same access as the parent namespace
    match /artifacts/{appId}/users/{uid}/kids/{kidId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy household path — deprecated, kept for data migration only.
    // New data should NOT be written here.
    match /households/{householdId} {
      allow read, write: if false; // deny all — no new household data
    }
    match /artifacts/{appId}/households/{householdId}/{document=**} {
      allow read, write: if false; // deny all — no new household data
    }
  }
}
