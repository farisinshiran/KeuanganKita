rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── App data: artifacts/{appId}/users/{anonUid}/... ─────────
    // Data is scoped to the signed-in Firebase Authentication UID.
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User settings
    match /artifacts/{appId}/users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kids feature
    match /artifacts/{appId}/users/{userId}/kids/{kidId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Family groups: families/{familyId} ─────────────────────
    // All members of a family can read the family doc (to get familyId, members list)
    // Only the creator can write the family metadata
    match /families/{familyId} {
      allow read:   if request.auth != null &&
                     request.auth.uid in resource.data.members;
      allow create: if request.auth != null &&
                     request.resource.data.createdBy == request.auth.uid &&
                     request.resource.data.members is list;
      allow update: if request.auth != null &&
                     request.auth.uid == resource.data.createdBy &&
                     request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if request.auth != null &&
                     request.auth.uid == resource.data.createdBy;
    }

    // ── Legacy household paths — deny all (deprecated) ─────────
    match /households/{householdId} {
      allow read, write: if false;
    }
    match /artifacts/{appId}/households/{householdId}/{document=**} {
      allow read, write: if false;
    }
  }
}
