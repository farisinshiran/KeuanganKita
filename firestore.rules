rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Household data: Any authenticated user can read households list.
    // Members (creator + joiners) can write their own household document.
    // PIN/passHash provides app-layer access control for joining.
    match /households/{householdId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow update if the requester is the creator OR their UID is in memberUids
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid in resource.data.memberUids
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Household user data: Same as users/{userId}, but under household namespace
    match /artifacts/{appId}/households/{householdId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Google user data: Only authenticated users can access their own data
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User settings (including Vision API key): Only authenticated users can access their own settings
    match /artifacts/{appId}/users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kids feature: same access as the parent namespace (household or user)
    match /artifacts/{appId}/households/{householdId}/kids/{kidId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /artifacts/{appId}/users/{userId}/kids/{kidId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}