# ============================================================
# Dompet Keluarga -- Environment Variables Template
# ============================================================
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in your Firebase project values (Project Settings > General > Your apps)
# 3. .env.local is git-ignored -- NEVER commit real credentials
# ============================================================

# --- Firebase (required) ---
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_hash
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firestore namespace (customize to isolate your data) ---
# This value becomes the root Firestore path: /artifacts/{VITE_APP_ID}/users/{uid}/...
VITE_APP_ID=dompet-keluarga

# --- GitHub Pages base path (injected automatically by CI -- do not set locally) ---
# VITE_BASE_URL=/dompet-keluarga/
